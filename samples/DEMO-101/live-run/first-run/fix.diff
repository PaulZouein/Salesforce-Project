--- a/force-app/main/default/classes/CaseEscalationServiceTest.cls
+++ b/force-app/main/default/classes/CaseEscalationServiceTest.cls
@@ -32,4 +32,26 @@
         c = [SELECT Priority FROM Case WHERE Id = :c.Id];
