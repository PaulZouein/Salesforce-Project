+
+    @isTest
+    static void premiumCasesAfterStandardCaseInSameBatchAreHighPriority() {
+        Account standard = createAccount('Standard Test Account', 'Standard');
+        Account premium = createAccount('Premium Test Account', 'Premium');
+
+        // The Standard case comes first: it must not stop the Premium cases after it.
+        List<Case> batch = new List<Case>{
+            new Case(Subject = 'Standard case', AccountId = standard.Id, Priority = 'Medium'),
+            new Case(Subject = 'Premium case 1', AccountId = premium.Id, Priority = 'Medium'),
+            new Case(Subject = 'Premium case 2', AccountId = premium.Id, Priority = 'Medium')
+        };
+
+        Test.startTest();
+        insert batch;
+        Test.stopTest();
+
+        Map<Id, Case> saved = new Map<Id, Case>([SELECT Id, Priority FROM Case WHERE Id IN :batch]);
+        System.assertEquals('Medium', saved.get(batch[0].Id).Priority);
+        System.assertEquals('High', saved.get(batch[1].Id).Priority);
+        System.assertEquals('High', saved.get(batch[2].Id).Priority);
+    }
